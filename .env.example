# ===== 필수 설정 (없으면 앱 안 됨) =====

# Google Gemini API 키 (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram 봇 토큰 (@BotFather에서 /newbot으로 발급)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 데이터베이스 (SQLite - 그대로 사용)
DATABASE_URL=file:./data/chat.db

# 암호화 키 (32자 이상 아무 문자열)
ENCRYPTION_KEY=my-super-secret-encryption-key-32chars

# JWT 인증 비밀키 (아무 문자열)
JWT_SECRET=my-jwt-secret-key

# ===== 선택 설정 (없어도 됨) =====

# OpenAI (GPT 사용 시)
# OPENAI_API_KEY=sk-...

# Anthropic Claude 사용 시
# ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth (Google 로그인 사용 시)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# 서버 포트 (기본 5000)
# PORT=5000
