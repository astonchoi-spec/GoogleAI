NODE_ENV=development
PORT=3000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
REDIS_FALLBACK=true
DATABASE_URL=file:./data/chat.db
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/webhooks/google/callback
WORKSPACE_SPREADSHEET_ID=
WORKSPACE_SPREADSHEET_TITLE=Aston Workspace Data
WORKSPACE_SHEET_TITLE=Workspace
DATA_GO_KR_API_KEY=
PUBLIC_DATA_API_KEY=
DART_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
LLM_ADAPTER=direct
LLM_PROVIDER=gemini
LLM_MODEL_KEY=pro
GEMINI_GROUNDING_ENABLED=true
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HERMES_API_KEY=
HERMES_BASE_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
NOTEBOOKLM_MCP_ENABLED=false
NOTEBOOKLM_MCP_URL=http://localhost:3100
WIKI_ROOT=G:\My Drive\Aston-Wiki
DEALS_ROOT=G:\내 드라이브\Aston-Deals
# VPS/Linux: DEALS_ROOT=/var/aston/deals
# 카톡 받은 파일 감시 (Windows)
KAKAO_DOWNLOAD_PATH=C:\Users\<사용자명>\Documents\카카오톡 받은 파일
# Mac 예시: KAKAO_DOWNLOAD_PATH=/Users/<user>/Documents/카카오톡 받은 파일
# 비활성화: KAKAO_DOWNLOAD_PATH=
# Gmail 자동 분류
GMAIL_ENABLED=true
GMAIL_AUTO_LABEL=Aston-Deals
GMAIL_POLL_INTERVAL_MIN=5
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SYNC_HOUR=6
GOOGLE_SHEETS_SYNC_MINUTE=30
GOOGLE_SHEETS_USER_ID=1
# 딜 마감/이정표 D-day 임박 텔레그램 푸시 (D-7, D-3, D-1, D-DAY, D+1)
# 비활성화: DEAL_DEADLINE_NOTIFY_ENABLED=false
DEAL_DEADLINE_NOTIFY_HOUR=8
DEAL_DEADLINE_NOTIFY_MINUTE=30
# 다운로드 폴더 감시 (Windows 기본)
DOWNLOAD_WATCH_PATH=
# 예시: DOWNLOAD_WATCH_PATH=C:\Users\<사용자명>\Downloads
# 비활성화: DOWNLOAD_WATCH_PATH=
# Telegram 1탭 승인 매매 — 단일 주문 한도(KRW), 일일 승인 매매 횟수, 승인 타임아웃(ms)
ENABLE_REAL_ORDERS=false
MAX_ORDER_KRW=500000
MAX_DAILY_AUTO_TRADES=5
APPROVAL_TIMEOUT_MS=300000
# Agent Control
# OPENCLAW_API_URL이 비어 있으면 localhost/127.0.0.1/host.docker.internal에서 자동 탐지
OPENCLAW_AUTO_DETECT=true
OPENCLAW_API_URL=
OPENCLAW_API_KEY=
OPENCLAW_PROBE_TIMEOUT_MS=3000
OPENCLAW_REQUEST_TIMEOUT_MS=120000
OPENCLAW_DEFAULT_MODEL=
# OPENCLAW_DEFAULT_MODEL이 비어 있으면 OpenClaw 설정 파일의 모델을 우선 사용
AGENT_APPROVAL_TIMEOUT_MIN=5
AGENT_PERMISSION_LEVEL=2
AGENT_WIKI_PATH=G:\Aston-Wiki\agents
GEMINI_API_KEY=
# GEMINI_API_KEY는 Aston 앱 기본 LLM 키이며, OpenClaw 설정에도 동일 키를 사용할 수 있음

# Aston RAG Track B — GCP Discovery Engine (Phase 2 활성)
# 인증: ADC (Application Default Credentials).
#   1) gcloud auth application-default login 으로 1회 인증
#   2) 본 앱은 어떤 JSON 키 파일도 요구하지 않음
# 비용: GenAI App Builder Trial credit 적용 시 Vertex AI Search 100% 커버
VERTEX_SEARCH_PROJECT_ID=
VERTEX_SEARCH_LOCATION=global
# Track A 회수용 Google Drive 폴더 ID (NotebookLM Docs export 대상 폴더 — Phase 3 활성)
DRIVE_WATCHER_FOLDER_ID=
